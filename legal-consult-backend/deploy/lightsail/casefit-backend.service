[Unit]
Description=caseFit FastAPI backend
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/legal-consult-backend
EnvironmentFile=/home/ubuntu/legal-consult-backend/.env
ExecStart=/home/ubuntu/legal-consult-backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
