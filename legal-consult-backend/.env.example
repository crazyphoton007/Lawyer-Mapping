# Copy this file to .env and fill in values.
# Neon example: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=postgresql+psycopg2://username:password@ep-xxx-yyy.us-east-2.aws.neon.tech:5432/mydb?sslmode=require

# App environment
APP_ENV=development
ENABLE_DOCS=1
CORS_ALLOW_ORIGINS=*

# Optional: Set to 1 for first run to auto-create tables without Alembic, then set to 0.
RUN_SYNC_DDL=1

# Auth / admin bootstrap
JWT_SECRET=change-me
JWT_EXPIRES_MIN=43200
ADMIN_BOOTSTRAP_KEY=choose-a-long-random-secret
OTP_PROVIDER=dev
OTP_FALLBACK_PROVIDER=dev
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
MSG91_TEMPLATE_OTP_KEY=OTP
MSG91_OTP_EXPIRY_MINUTES=5
MSG91_SEND_MODE=sendotp
MSG91_SMS_ROUTE=4
MSG91_DLT_TE_ID=
MSG91_MESSAGE_TEMPLATE=caseFit Technologies Pvt Ltd - Your OTP for login is {code}. Do not share it with anyone.
OTP_EXPIRES_SECONDS=300
OTP_RATE_LIMIT_COUNT=2
OTP_RATE_LIMIT_WINDOW_SECONDS=3600
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_SNS_SENDER_ID=
AWS_SNS_ENTITY_ID=
AWS_SNS_TEMPLATE_ID=
AWS_SNS_SMS_TYPE=Transactional
AWS_SNS_MESSAGE_TEMPLATE=Your caseFit OTP is {code}. It is valid for 5 minutes. Do not share it with anyone.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
OTP_EMAIL_SUBJECT=Your caseFit login code

# Payments
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
